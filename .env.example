# Postgres with the pgvector extension (Neon, Supabase, or docker compose).
SOVEREIGN_DATABASE_URL=postgresql://user:password@host/sovereign?sslmode=require

# Separate database for the test suite; tests wipe it.
SOVEREIGN_TEST_DATABASE_URL=

# Sign session cookies. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SOVEREIGN_JWT_SECRET=

# Needed for the "claude" model profile.
ANTHROPIC_API_KEY=
SOVEREIGN_ANTHROPIC_MODEL=claude-haiku-5-5

# Optional local models via Ollama (enable the "local-private" profile in settings).
SOVEREIGN_OLLAMA_URL=http://localhost:11434
SOVEREIGN_OLLAMA_MODEL=llama3.2
