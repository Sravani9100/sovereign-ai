# Postgres with the pgvector extension. `neon env pull` writes both of these.
# Pooled connection for the app:
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection for migrations (Alembic):
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Separate database for the test suite (direct connection); tests wipe it.
SOVEREIGN_TEST_DATABASE_URL=

# Sign session cookies. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SOVEREIGN_JWT_SECRET=

# Email sign-in codes. "console" prints codes to the API log (development only).
SOVEREIGN_EMAIL_BACKEND=console
# For real email, use any SMTP provider (Gmail app password, Brevo, Resend, Microsoft 365):
# SOVEREIGN_EMAIL_BACKEND=smtp
# SOVEREIGN_SMTP_HOST=smtp.gmail.com
# SOVEREIGN_SMTP_PORT=587
# SOVEREIGN_SMTP_USERNAME=you@gmail.com
# SOVEREIGN_SMTP_PASSWORD=your-app-password
# SOVEREIGN_EMAIL_FROM=SovereignAI <you@gmail.com>

# Optional: demo-data/seed.py adds you as a Musterwerk admin who signs in by email code.
# SOVEREIGN_SEED_ADMIN_EMAIL=you@example.com
# SOVEREIGN_SEED_ADMIN_NAME=Your Name

# Needed for the "claude" model profile.
ANTHROPIC_API_KEY=
SOVEREIGN_ANTHROPIC_MODEL=claude-haiku-5-5

# Optional local models via Ollama (enable the "local-private" profile in settings).
SOVEREIGN_OLLAMA_URL=http://localhost:11434
SOVEREIGN_OLLAMA_MODEL=llama3.2
